#!/usr/bin/env bash
# Vocoder sweep. Still NO reverb / echo / flanger.
set -euo pipefail
IN="${1:?usage: voc-test in.wav}"
OUT="${2:-$HOME/cyclops-voice/voc-out}"
HERE="$HOME/cyclops-voice"
mkdir -p "$OUT"; rm -f "$OUT"/*.wav "$OUT"/*.mp3
say(){ espeak-ng -v en-us -s 145 -p 25 -a 120 -w "$1" "$2" 2>/dev/null
       ffmpeg -v error -y -i "$1" -ar 48000 -ac 1 "$1.n.wav"; mv "$1.n.wav" "$1"; }
i=0; LIST=()
add(){ local label="$1"; shift; i=$((i+1)); local n=$(printf "%02d" $i)
  "$HERE/cyclops" "$IN" "$OUT/$n.wav" --preset vocoder --fl 0 --wet 0 --auto 0 \
      --pitch -3 --form 0.90 "$@" >/dev/null 2>&1
  ffmpeg -v error -y -i "$OUT/$n.wav" -ar 48000 -ac 1 -af "loudnorm=I=-18:TP=-2" "$OUT/$n.n.wav"
  mv "$OUT/$n.n.wav" "$OUT/$n.wav"; say "$OUT/$n.l.wav" "$label"
  LIST+=("$OUT/$n.l.wav" "$OUT/$n.wav"); echo "  $n  $label"; }

echo "VOCODER SWEEP - no reverb, no echo"
add "zero. no vocoder, voice only"        --voc 0    --sub 0.6
add "one. vocoder twenty five percent"    --voc 0.25 --sub 0.6
add "two. vocoder forty five percent"     --voc 0.45 --sub 0.6
add "three. vocoder seventy percent"      --voc 0.70 --sub 0.6
add "four. full vocoder, pure robot"      --voc 1.0  --sub 0.6
add "five. vocoder with octave below"     --voc 0.5  --chord oct   --sub 0.6
add "six. vocoder with a fifth"           --voc 0.5  --chord fifth --sub 0.6
add "seven. minor chord, harmonising"     --voc 0.55 --chord min   --sub 0.6
add "eight. minor seventh chord"          --voc 0.55 --chord min7  --sub 0.6
add "nine. wide, octave plus fifth"       --voc 0.55 --chord wide  --sub 0.6
add "ten. full robot with heavy sub"      --voc 0.9  --chord oct   --sub 0.8

ffmpeg -v error -y -f lavfi -t 0.5 -i anullsrc=r=48000:cl=mono "$OUT/g.wav"
A=(); F=""; k=0
for f in "${LIST[@]}"; do A+=(-i "$f"); F+="[$k]"; k=$((k+1)); A+=(-i "$OUT/g.wav"); F+="[$k]"; k=$((k+1)); done
ffmpeg -v error -y "${A[@]}" -filter_complex "${F}concat=n=$k:v=0:a=1" -ar 48000 "$OUT/VOC.wav"
ffmpeg -v error -y -i "$OUT/VOC.wav" -ac 1 -b:a 96k "$OUT/VOC.mp3"
rm -f "$OUT"/*.l.wav "$OUT/g.wav"
echo; echo "-> $OUT/VOC.mp3"
